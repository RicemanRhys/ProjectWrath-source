// The exe's Windows file properties (step 109, notes 18.112): Explorer's Details tab and Task Manager (which shows
// the description as the process's name). The packages ship this exe as ProjectWrath.exe. No company and no
// copyright are named: neither has been chosen (twoc/LICENSE's copyright line is the one place for the name).
// Step 110 (notes 18.113): the version is twoc/VERSION.txt's (1.0.0 for the first release), the file version text
// adds the build's commit and its date (build/generated/build_info.h, tools/build_info.cmake).
#include <winver.h>
#include "build_info.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TWOC_VER_MAJOR,TWOC_VER_MINOR,TWOC_VER_PATCH,0
 PRODUCTVERSION TWOC_VER_MAJOR,TWOC_VER_MINOR,TWOC_VER_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "Project Wrath"
            VALUE "FileDescription", "Project Wrath - an unofficial fan port (not affiliated with the owners of the game)"
            VALUE "OriginalFilename", "ProjectWrath.exe"
            VALUE "InternalName", "ProjectWrath"
            VALUE "FileVersion", TWOC_VERSION_FULL
            VALUE "ProductVersion", TWOC_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
