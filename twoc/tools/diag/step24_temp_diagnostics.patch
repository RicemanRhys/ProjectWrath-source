+            }
+        }
+        tmp_w("\r\nlock 0x152BB0:");
+        for (uint32_t a = 0x152BB0u; a < 0x152BD0u; a += 4) tmp_w(" %08X", tmp_g32(a));
+        tmp_w("\r\nvoices:");
+        for (i = 0; i < 6; i++) {
+            uint32_t v = 0x431ED8u + (uint32_t)i * 0x44u;
+            tmp_w(" [%d obj=%08X play=%02X stop=%02X start=%02X]", i, tmp_g32(v + 4),
+                  tmp_g32(v + 0x24) & 0xFF, tmp_g32(v + 0x38) & 0xFF, (tmp_g32(v + 0x38) >> 8) & 0xFF);
+        }
+        tmp_w("\r\n");
+    }
+}
