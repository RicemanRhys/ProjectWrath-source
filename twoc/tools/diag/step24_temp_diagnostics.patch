+/* ── TMP step 24: stream-thread hang sampler (NOT committed) ─────────────
+ *
+ * Every 3 s, with WriteFile + wvsprintfA only (no CRT locks):
+ *   - every other host thread: suspend, unwind up to 16 native frames with
+ *     RtlLookupFunctionEntry/RtlVirtualUnwind, resume, then symbolize (the
+ *     lifted functions are real sub_XXXXXXXX symbols);
+ *   - the stream thread's guest stack 0x01B4EE00..0x01B4F000: every dword
+ *     raw for 0x01B4EF00.., code-range words for the whole window, '*' if
+ *     changed since the last snapshot;
+ *   - DSOUND's lock 0x152BB0 (8 dwords) and the 6 stream voices' flags.
+ */
+#include <tlhelp32.h>
+#include <stdarg.h>
+
+static HANDLE tmp_f;
+
+static void tmp_w(const char *fmt, ...)
+{
+    char b[1024];
+    va_list ap;
+    DWORD w;
+    int n;
+    va_start(ap, fmt);
+    n = wvsprintfA(b, fmt, ap);
+    va_end(ap);
+    if (n > 0) WriteFile(tmp_f, b, (DWORD)n, &w, NULL);
+}
+
+static uint32_t tmp_g32(uint32_t va)
+{
+    return *(volatile uint32_t *)((uintptr_t)va + g_xbox_mem_offset);
+}
+
+static void tmp_sym(DWORD64 a)
+{
+    char buf[sizeof(SYMBOL_INFO) + 256];
+    SYMBOL_INFO *si = (SYMBOL_INFO *)buf;
+    DWORD64 disp = 0;
+    memset(buf, 0, sizeof(buf));
+    si->SizeOfStruct = sizeof(SYMBOL_INFO);
+    si->MaxNameLen = 255;
+    if (SymFromAddr(GetCurrentProcess(), a, &disp, si))
+        tmp_w(" %s+0x%X", si->Name, (unsigned)disp);
+    else
+        tmp_w(" %08X%08X", (unsigned)(a >> 32), (unsigned)a);
+}
+
+#define TMP_STK_LO 0x01B4EE00u
+#define TMP_STK_HI 0x01B4F000u
+
+static DWORD WINAPI tmp_sampler(LPVOID unused)
+{
+    static uint32_t prev[(TMP_STK_HI - TMP_STK_LO) / 4];
+    DWORD self = GetCurrentThreadId(), pid = GetCurrentProcessId();
+    DWORD t0 = GetTickCount();
+    (void)unused;
+
+    tmp_f = CreateFileA("hang_sampler.log", GENERIC_WRITE, FILE_SHARE_READ, NULL,
+                        CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    tmp_w("stderr handle type %u, stdout %u (1 disk, 2 char, 3 pipe)\r\n",
+          GetFileType(GetStdHandle(STD_ERROR_HANDLE)), GetFileType(GetStdHandle(STD_OUTPUT_HANDLE)));
+    for (;;) {
+        DWORD64 fr[48][24];
+        DWORD tid[48], susp[48], cpu[48];
+        int nfr[48], nt = 0, i, j;
+        HANDLE snap;
+        THREADENTRY32 te;
+
+        Sleep(3000);
+        tmp_w("=== t=%u ms exe base %08X%08X\r\n", GetTickCount() - t0,
+              (unsigned)((uintptr_t)GetModuleHandleA(NULL) >> 32), (unsigned)(uintptr_t)GetModuleHandleA(NULL));
+
+        snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        te.dwSize = sizeof(te);
+        for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+            HANDLE h;
+            CONTEXT c;
+            if (te.th32OwnerProcessID != pid || te.th32ThreadID == self || nt == 48)
+                continue;
+            h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, te.th32ThreadID);
+            if (!h) continue;
+            memset(&c, 0, sizeof(c));
+            c.ContextFlags = CONTEXT_FULL;
+            DWORD prev_susp;
+            FILETIME ct, et, kt, ut;
+            if ((prev_susp = SuspendThread(h)) != (DWORD)-1) {
+                if (GetThreadContext(h, &c)) {
+                    int k = 0;
+                    tid[nt] = te.th32ThreadID;
+                    susp[nt] = prev_susp;
+                    cpu[nt] = GetThreadTimes(h, &ct, &et, &kt, &ut)
+                        ? (DWORD)(((((ULONGLONG)kt.dwHighDateTime << 32) | kt.dwLowDateTime) +
+                                   (((ULONGLONG)ut.dwHighDateTime << 32) | ut.dwLowDateTime)) / 10000) : 0;
+                    while (k < 24 && c.Rip) {
+                        DWORD64 base, est;
+                        PRUNTIME_FUNCTION rf;
+                        void *hd;
+                        fr[nt][k++] = c.Rip;
+                        rf = RtlLookupFunctionEntry(c.Rip, &base, NULL);
+                        if (!rf) { c.Rip = *(DWORD64 *)c.Rsp; c.Rsp += 8; continue; }
+                        RtlVirtualUnwind(UNW_FLAG_NHANDLER, base, c.Rip, rf, &c, &hd, &est, NULL);
+                    }
+                    nfr[nt++] = k;
+                }
+                ResumeThread(h);
+            }
+            CloseHandle(h);
+        }
+        CloseHandle(snap);
+        for (i = 0; i < nt; i++) {
+            /* skip idle threads: frame 0 in ntdll wait with nothing of ours */
+            int ours = 0;
+            for (j = 0; j < nfr[i]; j++) {
+                char buf[sizeof(SYMBOL_INFO) + 64];
+                SYMBOL_INFO *si = (SYMBOL_INFO *)buf;
+                DWORD64 d;
+                memset(buf, 0, sizeof(buf));
+                si->SizeOfStruct = sizeof(SYMBOL_INFO);
+                si->MaxNameLen = 63;
+                if (SymFromAddr(GetCurrentProcess(), fr[i][j], &d, si) &&
+                    si->Name[0] == 's' && si->Name[1] == 'u' && si->Name[2] == 'b')
+                    ours = 1;
+            }
+            (void)ours;
+            tmp_w("tid %u [susp %u cpu %u ms]:", tid[i], susp[i], cpu[i]);
+            for (j = 0; j < nfr[i]; j++) tmp_sym(fr[i][j]);
+            tmp_w("\r\n");
+        }
+
+        tmp_w("stack raw 0x01B4EF00..:");
+        for (uint32_t a = 0x01B4EF00u; a < TMP_STK_HI; a += 4) {
+            if ((a & 0x1F) == 0) tmp_w("\r\n  %08X:", a);
+            tmp_w(" %08X", tmp_g32(a));
+        }
+        tmp_w("\r\nstack code words:");
+        for (uint32_t a = TMP_STK_LO; a < TMP_STK_HI; a += 4) {
+            uint32_t v = tmp_g32(a), idx = (a - TMP_STK_LO) / 4;
+            if (v >= 0x11000u && v < 0x15AA48u)
+                tmp_w(" %08X=%08X%s", a, v, v != prev[idx] ? "*" : "");
+            prev[idx] = v;
+        }
+        {
+            extern struct tmp_kqst_s { uint32_t ret, esp, arg, esi, ecx, ebp_, lo, hi; DWORD tid; volatile LONG n; } g_tmp_kqst[16];
+            extern volatile LONG g_tmp_kqst_used;
+            tmp_w("\r\nKeQuerySystemTime callers:");
+            for (i = 0; i < g_tmp_kqst_used; i++)
+                tmp_w("\r\n  ret=%08X n=%u esp=%08X arg=%08X time=%08X:%08X esi=%08X ecx=%08X ebp=%08X tid=%u",
+                      g_tmp_kqst[i].ret, (unsigned)g_tmp_kqst[i].n, g_tmp_kqst[i].esp, g_tmp_kqst[i].arg,
+                      g_tmp_kqst[i].hi, g_tmp_kqst[i].lo, g_tmp_kqst[i].esi, g_tmp_kqst[i].ecx,
+                      g_tmp_kqst[i].ebp_, g_tmp_kqst[i].tid);
+            /* the object (esi) of the busiest caller, 0xA0 bytes */
+            {
+                int best = -1;
+                for (i = 0; i < g_tmp_kqst_used; i++)
+                    if (best < 0 || g_tmp_kqst[i].n > g_tmp_kqst[best].n) best = i;
+                if (best >= 0 && g_tmp_kqst[best].esi >= 0x10000u && g_tmp_kqst[best].esi < 0x04000000u) {
+                    uint32_t o = g_tmp_kqst[best].esi;
