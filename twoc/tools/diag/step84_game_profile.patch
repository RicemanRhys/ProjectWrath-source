@@ -8419,2 +8449,49 @@ static void rt_leave(unsigned swap_no, const char *why)
  * frame itself), its next table set, the game side's settings. */
+/* Step 84 GPROF (measurement only): RECOMP_D3D_BRIDGE_GPROF=FILE, one CSV line a
+ * game frame from the game thread with the render thread on: the game side's
+ * ms (its Swap's return to this hand-over), the mirror's draws, immediate
+ * draws, swaps and the rest, the recording, the wait, draws and program
+ * draws recorded. twoc_fp_phase says what the game thread does, for hs84.py:
+ * 0 guest code, 1 recording, 7 mirror translation, 8 waiting in its Swap,
+ * 9 the rest of its Swap. */
+volatile int twoc_fp_phase;
+void d3db_gprof(LONG64 *t, LONG *vp, LONG *draws);
+static FILE *g_gpf;
+static int g_gp_init;
+static LONG64 g_gp_t[4];
+static LONG g_gp_vp, g_gp_dr;
+static double g_gp_rec;
+static unsigned g_gp_rd;
+
+static void gp_line(unsigned swap_no, double game_ms, double wait_ms)
+{
+    LONG64 t[4];
+    LONG vp, dr;
+    int i;
+    double ms[4];
+
+    if (!g_gp_init) {
+        const char *e = getenv("RECOMP_D3D_BRIDGE_GPROF");
+        g_gp_init = 1;
+        if (e && *e && (g_gpf = fopen(e, "w")) != NULL)
+            fprintf(g_gpf, "swap,game,mirror_draw,mirror_imm,mirror_swap,mirror_other,rec,wait,rec_draws,vp_draws,"
+                    "mirrored\n");
+    }
+    if (!g_gpf)
+        return;
+    d3db_gprof(t, &vp, &dr);
+    for (i = 0; i < 4; i++)
+        ms[i] = (double)(t[i] - g_gp_t[i]) * 1000.0 / (double)g_qpf.QuadPart;
+    fprintf(g_gpf, "%u,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%u,%ld,%ld\n", swap_no, game_ms, ms[0], ms[3], ms[1], ms[2],
+            g_stg.rec_ms - g_gp_rec, wait_ms, g_stg.rec_draws - g_gp_rd, (long)(vp - g_gp_vp), (long)(dr - g_gp_dr));
+    if ((swap_no & 63) == 0)
+        fflush(g_gpf);
+    for (i = 0; i < 4; i++)
+        g_gp_t[i] = t[i];
+    g_gp_vp = vp;
+    g_gp_dr = dr;
+    g_gp_rec = g_stg.rec_ms;
+    g_gp_rd = g_stg.rec_draws;
+}
+
 static void present_thread(double t_s, unsigned swap_no)
