+        for (int v = 0; v < MCPX_HW_MAX_VOICES && n < (int)sizeof buf - 600; v++) {
+            MtVoice *m = &mt_v[v];
+            if (!m->frames) continue;
+            n += snprintf(buf + n, sizeof buf - n, "[MIXTAP]  v%03X %s%s%s%s fmt %08X vbin %08X misc %08X psl %08X rate %.3f frames %u ea %.2f in %.1f |",
