+static double g_fp_rec0;
+static double g_fp_pace[9], g_fp_copy[9], g_fp_pres[9], g_fp_post[9];
+static double g_fp_ia, g_fp_begin, g_fp_pair0;
+static unsigned g_fp_draws;
+#define FP_TS 20
+static ID3D11Query *g_fp_q[8][FP_TS + 1];   /* [frame ring][0 disjoint, 1.. timestamps] */
+static unsigned g_fp_qn[8], g_fp_qswap[8], g_fp_qf;
+static unsigned char g_fp_qtag[8][FP_TS];
+static FILE *g_fpg;
+
+static double fp_ms(LARGE_INTEGER a, LARGE_INTEGER b)
+{
+    return (double)(b.QuadPart - a.QuadPart) * 1000.0 / (double)g_qpf.QuadPart;
+}
+
+static int fp_on(void)
+{
+    if (!g_fp_on_init) {
+        const char *e = getenv("RECOMP_D3D_BRIDGE_FPROF");
+        g_fp_on_init = 1;
+        g_fp_on = 0;
+        if (e && *e) {
+            char gp[600];
+            g_fpf = fopen(e, "w");
+            snprintf(gp, sizeof(gp), "%s.gpu", e);
+            g_fpg = fopen(gp, "w");
+            g_fp_on = g_fpf != NULL;
+            if (g_fpf)
+                fprintf(g_fpf, "swap,k,cmds,draws,game_wall,game_cpu,mirror_draw,mirror_other,rec,present_wall,present_cpu,"
+                        "ia,begin,pair,rp1,rp2,rp3,rp4,pace1,pace2,pace3,pace4,copy1,copy2,copy3,copy4,"
+                        "pres1,pres2,pres3,pres4,post1,post2,post3,post4,vp_draws,vp_off,vp_verts,vp_verts_off,prep,snap,hand\n");
+            if (g_fpg)
+                fprintf(g_fpg, "swap,tag:ms...\n");
+        }
+    }
+    return g_fp_on > 0;
+}
+
+/* A GPU timestamp with a tag (1-4 pass s began, 11-14 pass s ended, 21-24 copy s ended). */
+static void fp_ts(int tag)
+{
+    ID3D11Device *dev = d3d8_GetD3D11Device();
+    ID3D11DeviceContext *ctx = d3d8_GetD3D11Context();
+    unsigned f = g_fp_qf & 7, n = g_fp_qn[f];
+    D3D11_QUERY_DESC qd;
+
+    if (!g_fpg || n >= FP_TS || !dev)
+        return;
+    qd.MiscFlags = 0;
+    if (!g_fp_q[f][0]) {
+        qd.Query = D3D11_QUERY_TIMESTAMP_DISJOINT;
+        ID3D11Device_CreateQuery(dev, &qd, &g_fp_q[f][0]);
+    }
+    if (!g_fp_q[f][n + 1]) {
+        qd.Query = D3D11_QUERY_TIMESTAMP;
+        ID3D11Device_CreateQuery(dev, &qd, &g_fp_q[f][n + 1]);
+    }
+    if (n == 0)
+        ID3D11DeviceContext_Begin(ctx, (ID3D11Asynchronous *)g_fp_q[f][0]);
+    ID3D11DeviceContext_End(ctx, (ID3D11Asynchronous *)g_fp_q[f][n + 1]);
+    g_fp_qtag[f][n] = (unsigned char)tag;
+    g_fp_qn[f] = n + 1;
+}
+
+/* The frame's GPU queries closed; the one 4 frames back read if it is done. */
+static void fp_ts_end(unsigned swap_no)
+{
+    ID3D11DeviceContext *ctx = d3d8_GetD3D11Context();
+    unsigned f = g_fp_qf & 7, o, i;
+
+    if (!g_fpg)
+        return;
+    if (g_fp_qn[f])
+        ID3D11DeviceContext_End(ctx, (ID3D11Asynchronous *)g_fp_q[f][0]);
+    g_fp_qswap[f] = swap_no;
+    g_fp_qf++;
+    o = (g_fp_qf + 3) & 7;              /* 5 frames back */
+    if (g_fp_qn[o]) {
+        D3D11_QUERY_DATA_TIMESTAMP_DISJOINT dj;
+        UINT64 t[FP_TS];
+        int ok = ID3D11DeviceContext_GetData(ctx, (ID3D11Asynchronous *)g_fp_q[o][0], &dj, sizeof(dj),
+                                             D3D11_ASYNC_GETDATA_DONOTFLUSH) == S_OK;
+        for (i = 0; ok && i < g_fp_qn[o]; i++)
+            ok = ID3D11DeviceContext_GetData(ctx, (ID3D11Asynchronous *)g_fp_q[o][i + 1], &t[i], sizeof(t[i]),
+                                             D3D11_ASYNC_GETDATA_DONOTFLUSH) == S_OK;
+        if (ok && !dj.Disjoint && dj.Frequency) {
+            fprintf(g_fpg, "%u", g_fp_qswap[o]);
+            for (i = 0; i < g_fp_qn[o]; i++)
+                fprintf(g_fpg, ",%u:%.3f", g_fp_qtag[o][i], (double)(t[i] - t[0]) * 1000.0 / (double)dj.Frequency);
+            fprintf(g_fpg, "\n");
+        } else {
+            fprintf(g_fpg, "%u,unread\n", g_fp_qswap[o]);
+        }
+        g_fp_qn[o] = 0;
+    }
+}
