+/* TMP step 87: depth-stencil snapshots: every render target's depth and the
+ * back buffer's (the stand-in's, or the default views'), taken (0) or put
+ * back (1). */
+static ID3D11Texture2D *g_tmp_dsnap[RT_SLOTS + 1];
+static ID3D11Texture2D *tmp_dsrc(int i)
+{
+    ID3D11Texture2D *t = NULL;
+    if (i < RT_SLOTS) {
+        if (g_rt[i].depth && ((D3D8Surface *)g_rt[i].depth)->d3d11_texture) {
+            t = ((D3D8Surface *)g_rt[i].depth)->d3d11_texture;
+            ID3D11Texture2D_AddRef(t);
+        }
+    } else if (g_bb.depth) {
+        t = ((D3D8Surface *)g_bb.depth)->d3d11_texture;
+        if (t)
+            ID3D11Texture2D_AddRef(t);
+    } else {
+        d3dh_target_t z;
+        ID3D11RenderTargetView *rtv = NULL;
+        ID3D11DepthStencilView *dsv = NULL;
+        memset(&z, 0, sizeof(z));
+        bind_target(&z);
+        ID3D11DeviceContext_OMGetRenderTargets(d3d8_GetD3D11Context(), 1, &rtv, &dsv);
+        if (rtv)
+            ID3D11RenderTargetView_Release(rtv);
+        if (dsv) {
+            ID3D11DepthStencilView_GetResource(dsv, (ID3D11Resource **)&t);
+            ID3D11DepthStencilView_Release(dsv);
+        }
+    }
+    return t;
+}
+static void tmp_depth(int restore)
+{
+    ID3D11DeviceContext *ctx = d3d8_GetD3D11Context();
+    D3D11_TEXTURE2D_DESC a, b;
+    int i;
+    for (i = 0; i <= RT_SLOTS; i++) {
+        ID3D11Texture2D *t = tmp_dsrc(i);
+        if (!t)
+            continue;
+        ID3D11Texture2D_GetDesc(t, &a);
+        if (g_tmp_dsnap[i]) {
+            ID3D11Texture2D_GetDesc(g_tmp_dsnap[i], &b);
+            if (b.Width != a.Width || b.Height != a.Height || b.Format != a.Format || b.SampleDesc.Count !=
+                a.SampleDesc.Count) {
+                ID3D11Texture2D_Release(g_tmp_dsnap[i]);
+                g_tmp_dsnap[i] = NULL;
+            }
+        }
+        if (!restore) {
+            if (!g_tmp_dsnap[i] && FAILED(ID3D11Device_CreateTexture2D(d3d8_GetD3D11Device(), &a, NULL, &g_tmp_dsnap[i])))
+                g_tmp_dsnap[i] = NULL;
+            if (g_tmp_dsnap[i])
+                ID3D11DeviceContext_CopyResource(ctx, (ID3D11Resource *)g_tmp_dsnap[i], (ID3D11Resource *)t);
+        } else if (g_tmp_dsnap[i]) {
+            ID3D11DeviceContext_CopyResource(ctx, (ID3D11Resource *)t, (ID3D11Resource *)g_tmp_dsnap[i]);
+        }
+        ID3D11Texture2D_Release(t);
+    }
+}
