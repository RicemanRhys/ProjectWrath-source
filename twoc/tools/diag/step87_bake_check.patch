+/* TMP step 87: with TMP_ICHECK=1 a pass drawn from the captures is drawn
+ * the ordinary way first, from the targets as they are, then from the
+ * captures from the same targets, and the back buffers compared. */
+static int g_tmp_icheck = -1;
+static void tmp_pass(int interp, unsigned swap_no)
+{
+    ID3D11Texture2D *bb;
+
+    if (g_tmp_icheck < 0) {
+        const char *e = getenv("TMP_ICHECK");
+        g_tmp_icheck = e && (*e == '1' || *e == '2') ? *e - '0' : 0;   /* 2: both passes the ordinary way */
+        if (g_tmp_icheck)
+            fprintf(stderr, "[TMP] bake check: each pass after a frame's first drawn the ordinary way, then %s,"
+                    " compared (colour and depth-stencil put back between)\n",
+                    g_tmp_icheck == 2 ? "the ordinary way again (the check's own floor)" : "from its captures");
+    }
+    if (!g_tmp_icheck || !g_bake || g_bk_plan <= 1 || g_bk_pass == 0) {
+        replay_pass(interp);
+        return;
+    }
+    bb = back_tex();                    /* where both start */
+    if (bb) {
+        replay_check_snap(0, bb);
+        ID3D11Texture2D_Release(bb);
+    }
+    tmp_depth(0);
+    g_tmp_plain = 1;
+    replay_pass(interp);
+    g_tmp_plain = 0;
+    g_bk_pass--;                        /* the pass again */
+    replay_check(0, swap_no);           /* kept, the targets put back */
+    tmp_depth(1);                       /* and their depth */
+    g_tmp_plain = g_tmp_icheck == 2;
+    replay_pass(interp);
+    g_tmp_plain = 0;
+    replay_check(1, swap_no);           /* compared */
+}
