+/* TMP step 47: TMP_WATCH=VA hardware write watch on guest VA (4 bytes) on every other thread;
+ * TMP_WATCH2=VA a second one. Each hit: one line "W frame rip value" to TMP_WATCHLOG. */
+static HANDLE tmp_wlog;
+static uint32_t tmp_draw_esp;
+
+/* TMP step 47: from the lifted sub_00090BE0's end. out: +0 t, +4 local, +8 block, +0xC mask, +0x10 byte;
+ * what a true floor gives, and each disagreement (TMP_ANIMLOG). */
+void tmp_anim_log(uint32_t out, uint32_t anim, uint32_t ret)
+{
+    static FILE *f;
+    static unsigned calls, bad, lines;
+    float t = MEMF(out);
+    int nb = (int)MEM32(anim + 8), kc, yc, ic, sc, mc;
+    float lc;
+    if (!getenv("TMP_ANIMLOG"))
+        return;
+    if (!f) {
+        f = fopen(getenv("TMP_ANIMLOG"), "w");
+        if (!f)
+            return;
+        setvbuf(f, NULL, _IOFBF, 1 << 20);
+    }
+    kc = (int)floor(((double)t - 1.0) * 0.03125);
+    if (kc >= nb)
+        kc = nb - 1;
+    lc = (float)((double)t - (double)(kc << 5));
+    yc = (int)floor((double)lc) - 1;
+    ic = (uint8_t)(yc / 8);
+    sc = yc % 8;
+    mc = (uint8_t)((1u << ((sc + 1) & 31)) - 1);
+    calls++;
+    if ((int)MEM32(out + 8) != kc || MEMF(out + 4) != lc || (int)MEM32(out + 0x10) != ic || (int)MEM32(out + 0xC) != mc) {
+        bad++;
+        if (lines++ < 200000)
+            fprintf(f, "X %u %08X %08X nb %d t %.4f | k %d/%d local %.4f/%.4f byte %u/%d mask %02X/%02X\n",
+                    MEM32(GAME_FRAME_COUNTER), ret, anim, nb, (double)t, (int)MEM32(out + 8), kc,
+                    (double)MEMF(out + 4), (double)lc, MEM32(out + 0x10), ic, MEM32(out + 0xC), mc);
+    }
+    if ((calls & 0x3FFF) == 0) {
+        fprintf(f, "N calls %u disagree %u\n", calls, bad);
+        fflush(f);
+    }
+}
+static volatile uint32_t tmp_waddr[2];
+static LONG CALLBACK tmp_watch_veh(EXCEPTION_POINTERS *e)
+{
+    if (e->ExceptionRecord->ExceptionCode == EXCEPTION_SINGLE_STEP && (e->ContextRecord->Dr6 & 3)) {
+        char b[160];
+        DWORD w;
+        int k = (e->ContextRecord->Dr6 & 1) ? 0 : 1;
+        int len = wsprintfA(b, "W%d %u %p %08X %u\n", k, MEM32(GAME_FRAME_COUNTER), (void *)e->ContextRecord->Rip,
+                            MEM32(tmp_waddr[k]), GetCurrentThreadId());
+        WriteFile(tmp_wlog, b, len, &w, NULL);
+        e->ContextRecord->Dr6 = 0;
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+static DWORD WINAPI tmp_watch_thread(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        THREADENTRY32 te;
+        te.dwSize = sizeof(te);
+        if (snap != INVALID_HANDLE_VALUE && Thread32First(snap, &te)) {
+            do {
+                HANDLE th;
+                CONTEXT c;
+                if (te.th32OwnerProcessID != GetCurrentProcessId() || te.th32ThreadID == GetCurrentThreadId())
+                    continue;
+                th = OpenThread(THREAD_ALL_ACCESS, FALSE, te.th32ThreadID);
+                if (!th)
+                    continue;
+                SuspendThread(th);
+                memset(&c, 0, sizeof(c));
+                c.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+                if (GetThreadContext(th, &c)) {
+                    c.Dr0 = XBOX_PTR(tmp_waddr[0]);
+                    c.Dr7 = (1u << 0) | (1u << 16) | (3u << 18);           /* L0, write, 4 bytes */
+                    if (tmp_waddr[1]) {
+                        c.Dr1 = XBOX_PTR(tmp_waddr[1]);
+                        c.Dr7 |= (1u << 2) | (1u << 20) | (3u << 22);
+                    }
+                    SetThreadContext(th, &c);
+                }
+                ResumeThread(th);
+                CloseHandle(th);
+            } while (Thread32Next(snap, &te));
+        }
+        if (snap != INVALID_HANDLE_VALUE)
+            CloseHandle(snap);
+        Sleep(500);
+    }
+}
+static void tmp_watch_start(void)
+{
+    static int started;
+    if (started || !getenv("TMP_WATCH"))
+        return;
+    started = 1;
+    tmp_waddr[0] = strtoul(getenv("TMP_WATCH"), NULL, 16);
+    if (getenv("TMP_WATCH2"))
+        tmp_waddr[1] = strtoul(getenv("TMP_WATCH2"), NULL, 16);
+    tmp_wlog = CreateFileA(getenv("TMP_WATCHLOG"), GENERIC_WRITE, FILE_SHARE_READ, NULL, CREATE_ALWAYS, 0, NULL);
+    AddVectoredExceptionHandler(1, tmp_watch_veh);
+    CreateThread(NULL, 0, tmp_watch_thread, NULL, 0, NULL);
+    fprintf(stderr, "[TMP] watching %08X %08X, exe base %p\n", tmp_waddr[0], tmp_waddr[1], (void *)GetModuleHandleA(NULL));
+}
