+/* ── TMP step 26: time-profile sampler (NOT committed) ─────────────────
+ *
+ * Every 100 ms, with WriteFile + wvsprintfA only (no CRT locks): suspend
+ * each other host thread, unwind up to 12 native frames, resume, and log the
+ * raw frames plus the thread's CPU time. The header carries guest GPU state:
+ * USER DMA_PUT/GET, the D3D fence pair (dev+0x30 / *(dev+0x34)), the PFB
+ * flush register and the vblank count. prof.py aggregates it offline with the
+ * /MAP linker map.
+ */
+#include <tlhelp32.h>
+#include <stdarg.h>
+
+static HANDLE tmp_f;
+static DWORD tmp_main_tid;
+
+static void tmp_w(const char *fmt, ...)
+{
+    char b[1024];
+    va_list ap;
+    DWORD w;
+    int n;
+    va_start(ap, fmt);
+    n = wvsprintfA(b, fmt, ap);
+    va_end(ap);
+    if (n > 0) WriteFile(tmp_f, b, (DWORD)n, &w, NULL);
+}
+
+static uint32_t tmp_g32(uint32_t va)
+{
+    return *(volatile uint32_t *)((uintptr_t)va + g_xbox_mem_offset);
+}
+
+static DWORD WINAPI tmp_sampler(LPVOID unused)
+{
+    DWORD self = GetCurrentThreadId(), pid = GetCurrentProcessId();
+    DWORD t0 = GetTickCount();
+    uintptr_t base = (uintptr_t)GetModuleHandleA(NULL);
+    (void)unused;
+
+    tmp_f = CreateFileA("prof_sampler.log", GENERIC_WRITE, FILE_SHARE_READ, NULL,
+                        CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    tmp_w("main tid %u\r\n", tmp_main_tid);
+    for (;;) {
+        HANDLE snap;
+        THREADENTRY32 te;
+        uint32_t dev;
+
+        Sleep(100);
+        dev = tmp_g32(0x0010EBF0u);
+        tmp_w("=== t=%u ms exe base %08X%08X put=%08X get=%08X fence=%08X gpu=%08X pfb=%08X vbl=%u\r\n",
+              GetTickCount() - t0, (unsigned)(base >> 32), (unsigned)base,
+              tmp_g32(0xFD800040u), tmp_g32(0xFD800044u),
+              dev ? tmp_g32(dev + 0x30) : 0, dev ? tmp_g32(tmp_g32(dev + 0x34)) : 0,
+              tmp_g32(0xFD100410u), tmp_g32(0x001BABB0u));
+
+        snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        te.dwSize = sizeof(te);
+        for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+            DWORD64 fr[12];
+            int k = 0, j;
+            HANDLE h;
+            CONTEXT c;
+            FILETIME ct, et, kt, ut;
+            DWORD cpu = 0;
+
+            if (te.th32OwnerProcessID != pid || te.th32ThreadID == self)
+                continue;
+            h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION,
+                           FALSE, te.th32ThreadID);
+            if (!h) continue;
+            memset(&c, 0, sizeof(c));
+            c.ContextFlags = CONTEXT_FULL;
+            if (SuspendThread(h) != (DWORD)-1) {
+                if (GetThreadContext(h, &c)) {
+                    while (k < 12 && c.Rip) {
+                        DWORD64 ib, est;
+                        PRUNTIME_FUNCTION rf;
+                        void *hd;
+                        fr[k++] = c.Rip;
+                        rf = RtlLookupFunctionEntry(c.Rip, &ib, NULL);
+                        if (!rf) { c.Rip = *(DWORD64 *)c.Rsp; c.Rsp += 8; continue; }
+                        RtlVirtualUnwind(UNW_FLAG_NHANDLER, ib, c.Rip, rf, &c, &hd, &est, NULL);
+                    }
+                }
+                ResumeThread(h);
+            }
+            if (GetThreadTimes(h, &ct, &et, &kt, &ut))
+                cpu = (DWORD)(((((ULONGLONG)kt.dwHighDateTime << 32) | kt.dwLowDateTime) +
+                               (((ULONGLONG)ut.dwHighDateTime << 32) | ut.dwLowDateTime)) / 10000);
+            CloseHandle(h);
+            tmp_w("tid %u [cpu %u ms]:", te.th32ThreadID, cpu);
+            for (j = 0; j < k; j++)
+                tmp_w(" %08X%08X", (unsigned)(fr[j] >> 32), (unsigned)fr[j]);
+            tmp_w("\r\n");
+        }
+        CloseHandle(snap);
+    }
+}
+/* ── end TMP ─────────────────────────────────────────────────────────── */
+
